// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(LAWYER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  caseAnalyses CaseAnalysis[]
  judgments    Judgment[]
  judgeProfile JudgeProfile?
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  LAWYER
  JUDGE
  RESEARCHER
  ADMIN
}

enum CourtType {
  SUPREME_COURT
  HIGH_COURT
  DISTRICT_COURT
  SPECIAL_TRIBUNAL
}

enum CaseStatus {
  PENDING
  UNDER_REVIEW
  ANALYZED
  CLOSED
}

enum JudgmentType {
  FINAL
  INTERIM
  REVIEW
  APPEAL
}

enum BiasType {
  GENDER
  RELIGION
  CASTE
  ECONOMIC
  REGIONAL
  AGE
  POLITICAL
}

model Court {
  id          String     @id @default(cuid())
  name        String
  type        CourtType
  jurisdiction String?
  location    String?
  established DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  cases       LegalCase[]
  judgments   Judgment[]
  judges      JudgeProfile[]
}

model JudgeProfile {
  id          String   @id @default(cuid())
  name        String
  experience  Int      // years of experience
  specialization String?
  biography   String?
  courtId     String
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  court       Court    @relation(fields: [courtId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
  judgments   Judgment[]
}

model LegalCase {
  id            String      @id @default(cuid())
  caseNumber    String      @unique
  title         String
  description   String
  facts         String      // Detailed case facts
  legalIssues   String      // Legal issues involved
  caseType      String      // Civil, Criminal, Constitutional, etc.
  filingDate    DateTime
  status        CaseStatus  @default(PENDING)
  courtId       String
  priority      Int         @default(1) // 1-5 priority scale
  tags          String?     // JSON string for tags array
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  court         Court       @relation(fields: [courtId], references: [id])
  judgments     Judgment[]
  citations     LegalCitation[]
  analyses      CaseAnalysis[]
  precedents    CasePrecedent[]
}

model Law {
  id            String   @id @default(cuid())
  title         String
  type          String   // Act, Amendment, Constitution, etc.
  section       String?
  description   String
  content       String   // Full text of the law
  effectiveDate DateTime
  isRepealed    Boolean  @default(false)
  repealedDate  DateTime?
  category      String   // Criminal, Civil, Constitutional, etc.
  tags          String?  // JSON string for tags array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  citations     LegalCitation[]
}

model Judgment {
  id            String       @id @default(cuid())
  caseId        String
  judgeId       String
  courtId       String
  judgmentType  JudgmentType
  summary       String
  fullText      String
  decision      String       // The final decision
  reasoning     String       // Legal reasoning
  dateDelivered DateTime
  isPublished   Boolean      @default(false)
  confidence    Float?       // AI confidence score (0-1)
  biasScore     Float?       // Bias detection score (0-1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  case          LegalCase    @relation(fields: [caseId], references: [id])
  judge         JudgeProfile @relation(fields: [judgeId], references: [id])
  court         Court        @relation(fields: [courtId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?
}

model LegalCitation {
  id          String   @id @default(cuid())
  caseId      String
  lawId       String?
  citation    String   // Formal citation format
  context     String   // How it's used in the case
  relevance   Float    @default(1.0) // Relevance score
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  case        LegalCase @relation(fields: [caseId], references: [id])
  law         Law?      @relation(fields: [lawId], references: [id])
}

model Precedent {
  id            String   @id @default(cuid())
  title         String
  citation      String
  summary       String
  keyPoints     String?  // JSON string for key points array
  caseType      String
  court         String
  date          DateTime
  isBinding     Boolean  @default(true)
  tags          String?  // JSON string for tags array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  cases         CasePrecedent[]
}

model CasePrecedent {
  id          String   @id @default(cuid())
  caseId      String
  precedentId String
  similarity  Float    @default(0.0) // Similarity score (0-1)
  relevance   String   // How this precedent is relevant
  createdAt   DateTime @default(now())
  
  case        LegalCase @relation(fields: [caseId], references: [id])
  precedent   Precedent @relation(fields: [precedentId], references: [id])
  
  @@unique([caseId, precedentId])
}

model CaseAnalysis {
  id                String   @id @default(cuid())
  caseId            String
  userId            String
  analysisType      String   // PRECEDENT_ANALYSIS, BIAS_DETECTION, LEGAL_REASONING, etc.
  result            String   // JSON string with analysis results
  confidence        Float    // AI confidence score (0-1)
  processingTime    Int      // Processing time in milliseconds
  modelUsed         String   // AI model used for analysis
  createdAt         DateTime @default(now())
  
  case              LegalCase @relation(fields: [caseId], references: [id])
  user              User      @relation(fields: [userId], references: [id])
  biasDetections    BiasDetection[]
}

model BiasDetection {
  id            String   @id @default(cuid())
  analysisId    String
  biasType      BiasType
  severity      Float    // Severity score (0-1)
  context       String   // Where bias was detected
  suggestion    String   // How to mitigate the bias
  detectedAt    DateTime @default(now())
  
  analysis      CaseAnalysis @relation(fields: [analysisId], references: [id])
}

model LegalKnowledge {
  id            String   @id @default(cuid())
  title         String
  content       String
  type          String   // CONCEPT, PRINCIPLE, DOCTRINE, DEFINITION
  category      String   // Legal category
  source        String?  // Source of the knowledge
  embedding     String?  // Vector embedding as string
  tags          String?  // JSON string for tags array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}